{
  "name": "{{{appName}}}",
  "version": "0.0.0",
  "description": "Gasket App",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs": "node gasket.ts docs",
    "build": "node gasket.ts build",
    "preview": "npm run build && npm run start",
    "start": "node server.ts",
    "local": "node --watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "@gasket/core": "next",
    "@gasket/plugin-command": "next",
    "@gasket/plugin-dynamic-plugins": "next",
    "@gasket/plugin-express": "next",
    "@gasket/plugin-https": "next",
    "@gasket/plugin-logger": "next",
    "@gasket/plugin-swagger": "next",
    "@gasket/plugin-winston": "next",
    "@gasket/request": "next",
    "@gasket/utils": "next",
    "express": "^4.21.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@gasket/plugin-docs": "next",
    "@gasket/plugin-docusaurus": "next",
    "@gasket/plugin-metadata": "next",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.17.1",
    "eslint": "^9.31.0",
    "eslint-config-godaddy": "^8.0.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "search-insights": "^2.17.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
