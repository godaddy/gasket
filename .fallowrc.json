{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "duplicates": {
    "minOccurrences": 3
  },
  "ignorePatterns": [
    "**/generator/**",
    "site/**"
  ],
  "dynamicallyLoaded": [
    "scripts/generate-docs-index/**",
    "packages/gasket-plugin-nextjs/lib/noop-replacement.mjs",
    "packages/gasket-plugin-dynamic-plugins/test/__mocks__/plugin-custom.js",
    "syncpack.config.cjs"
  ],
  "ignoreDependencies": [
    "@babel/plugin-transform-runtime",
    "@babel/preset-env",
    "@babel/preset-react",
    "@babel/register",
    "@eslint/eslintrc",
    "@eslint/js",
    "@gasket/assets",
    "@gasket/data",
    "@gasket/intl",
    "@gasket/nextjs",
    "@gasket/plugin-analyze",
    "@gasket/plugin-command",
    "@gasket/plugin-data",
    "@gasket/plugin-docs",
    "@gasket/plugin-docs-graphs",
    "@gasket/plugin-docusaurus",
    "@gasket/plugin-dynamic-plugins",
    "@gasket/plugin-elastic-apm",
    "@gasket/plugin-express",
    "@gasket/plugin-fastify",
    "@gasket/plugin-happyfeet",
    "@gasket/plugin-https",
    "@gasket/plugin-https-proxy",
    "@gasket/plugin-intl",
    "@gasket/plugin-logger",
    "@gasket/plugin-metadata",
    "@gasket/plugin-morgan",
    "@gasket/plugin-nextjs",
    "@gasket/plugin-swagger",
    "@gasket/plugin-webpack",
    "@gasket/plugin-winston",
    "@gasket/react-intl",
    "@gasket/request",
    "@gasket/template-api-express",
    "@gasket/template-api-fastify",
    "@gasket/template-nextjs-app",
    "@gasket/template-nextjs-express",
    "@gasket/template-nextjs-pages",
    "@gasket/utils",
    "@godaddy/terminus",
    "core-js",
    "create-gasket-app",
    "debug",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "fastify",
    "npm-check-updates",
    "prompts",
    "react",
    "react-intl",
    "regenerator-runtime"
  ]
